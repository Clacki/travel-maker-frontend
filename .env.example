# API server URL
NEXT_PUBLIC_API_URL=

# Data source: mock (direct fixture repository) or api (real backend)
NEXT_PUBLIC_DATA_SOURCE=mock

# Optional development/test network mocking (never enabled in production)
NEXT_PUBLIC_MSW_ENABLED=false

# Frontend deployment URL
NEXT_PUBLIC_SITE_URL=https://travel-maker-frontend.vercel.app

# Kakao OAuth authorize configuration
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=

# Kakao Map
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
